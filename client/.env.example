# Copy to `.env.local` (git-ignored) to override anything here. No secrets belong
# in these files: everything VITE_* ends up in the public bundle.

# The game's id on Bloxity (My Games). This is also the built-in default.
VITE_GAME_SLUG=1-boomerang-per-click

# Bloxity endpoints. Leave these as-is unless you are running the portal locally.
# They MUST be set: without them the SDK repoints itself at localhost when it
# detects a dev server, and the login popup can never return a token.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# Colyseus game server for a direct connection. In dev (Vite on :5173) the client
# falls back to http://<host>:2567. On Bloxity hosting this is the backend's HTTP
# host (https://1-boomerang-per-click.host.bloxity.io, or .dev.host.bloxity.io).
# VITE_SERVER_URL=http://localhost:2567

# Bloxity Legion hosting (set by .github/workflows/deploy.yml, not in local dev):
# when set, players join through the matchmaker at play.bloxity.io instead of
# connecting to VITE_SERVER_URL. VITE_LEGION_VERSION=preview reaches the dev
# backend from a custom domain.
# VITE_LEGION_GAME_ID=1-boomerang-per-click
# VITE_LEGION_VERSION=preview
